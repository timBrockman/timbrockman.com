    <header id="pageHeader" class="page-header">
      <div class="secHeader">
        <div class="bannerWrap preview-card preview-clip">
          <amp-img src="/images/{{ imagePrefix }}-465_project.png" alt="{{ imageAlt }}"
            srcset="/images/{{imagePrefix}}-465_project.png 1024w, images/{{ imagePrefix }}-354_project.png 768w, images/{{ imagePrefix }}-240_project.png 320w"
            width="100"
            height="100"
            layout="responsive"
            class="banner"></amp-img>
        </div>
        <div>
          <h3 class="dropout rightEdge pad">{{ title }}</h3>
          <h6 class="rightEdge pad">{{ subtitle }}</h6>
        </div>
      </div>
    </header>
