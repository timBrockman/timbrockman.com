<!doctype html>
<html amp lang="en">
{% include 'snippets/meta/amp-head.liquid' %}
  <body>
    {% include 'snippets/sidebar/amp-sidebar.liquid' %}

    <div class="site-shell">
      <div class="site-wrapper">
        {% include 'snippets/header/id-header.liquid' %}
        {% include 'snippets/header/page-header.liquid' %}

        <main class="main-content">
          {% if content %}
            <section class="content">
              <div class="secBody">
                {{ content }}
              </div>
            </section>
          {% endif %}

          <div class="section-heading">
            <div>
              <h2>{{ title }}</h2>
              {% if subtitle %}<p>{{ subtitle }}</p>{% endif %}
            </div>
          </div>

          <div class="card-grid">
            {% if page.data.listType == "posts" %}
              {% assign items = collections.posts %}
            {% elsif page.data.listType == "projects" %}
              {% assign items = collections.projects %}
            {% else %}
              {% assign items = collections.projects %}
            {% endif %}

            {% for project in items %}
              {% include 'components/project-card.liquid', project: project %}
            {% endfor %}
          </div>
        </main>

        {% include 'snippets/footer/footer.liquid' %}
      </div>
    </div>

  {% include 'snippets/body/analytics.liquid' %}
  </body>
</html>
