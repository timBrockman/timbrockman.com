<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Dynamically pulls the title set in your index file front matter -->
  <title>{{ title | default: "My Eleventy Site" }}</title>
  
  <style>
    /* Basic layout resets */
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
    }
    .site-wrapper {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 20px;
    }
    header {
      padding: 20px 0;
      border-bottom: 1px solid #eee;
      margin-bottom: 40px;
    }
    header nav a {
      margin-right: 20px;
      text-decoration: none;
      color: #0076df;
      font-weight: bold;
    }
    footer {
      margin-top: 60px;
      padding: 20px 0;
      border-top: 1px solid #eee;
      font-size: 0.9rem;
      color: #777;
    }
    /* Native smooth scrolling for your sidebar links */
    html {
      scroll-behavior: smooth;
    }
  </style>
</head>
<body>

  <div class="site-wrapper">
    
    <!-- Global Header & Navigation -->
    <header>
      <nav>
        <a href="/">Home</a>
        <a href="/posts/">Posts</a>
        <a href="/projects/">Projects</a>
      </nav>
    </header>

    <!-- 
      THE CRITICAL PIECE: 
      Eleventy injects your index.md template content right here 
    -->
    {{ content }}

    <!-- Global Footer -->
    <footer>
      <p>&copy; {{ "now" | date: "%Y" }} My Eleventy Site. Built with Liquid.</p>
    </footer>

  </div>

</body>
</html>
